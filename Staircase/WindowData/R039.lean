theorem all_valid (r : Rule) (h : r ∈ rules) : r.Valid := by
  rcases List.mem_cons.mp h with rfl | tail
  · exact valid
  · exact Staircase.WindowData.R035.all_valid r tail

end Staircase.WindowData.R039
