theorem valid : rule.Valid := by
  apply checkWindow_parts (C := origins) (box := boxes)
  · decide +kernel
  · apply every_iff.mp
    change every 26 origins.nodeOK = true
    simp only [every,n0,n1,n2,n3,n4,n5,n6,n7,n8,n9,n10,n11,n12,n13,n14,n15,n16,n17,n18,n19,n20,n21,n22,n23,n24,n25, Bool.true_and]
  · decide +kernel

def rules : List Rule := rule :: Staircase.WindowData.R206.rules
theorem all_valid (r : Rule) (h : r ∈ rules) : r.Valid := by
  rcases List.mem_cons.mp h with rfl | tail
  · exact valid
  · exact Staircase.WindowData.R206.all_valid r tail

end Staircase.WindowData.R210
