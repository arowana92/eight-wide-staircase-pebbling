def base1 : List Nat := [0, 1, 2, 3]

theorem base1_reaches (t : Nat) (ht : t < 4) :
    Reaches (Adj 1) (↑base1) t := by
  apply covers_sound (k := 4) (paths := [
    [],
    [],
    [],
    []])
  · decide
  · exact ht

