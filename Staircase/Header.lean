theorem header : machine.Header listedRules := by
  refine ⟨?_,?_,?_,?_,?_⟩
  · intro i hi
    simpa only [Nat.zero_add,startTest,decide_eq_true_eq] using startAll i hi
  · intro i hi
    simpa only [Nat.zero_add,letterTest,decide_eq_true_eq] using letterAll i hi
  · intro i hi
    simpa only [Nat.zero_add,endTest,decide_eq_true_eq] using endAll i hi
  · decide +kernel
  · intro i hi
    have len : machine.positions.length=1111 := by decide +kernel
    rw [len] at hi
    simpa only [Nat.zero_add] using linkAll i hi

